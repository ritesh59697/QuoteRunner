# --- LLM (task parsing + bid explanation) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# --- OKX.AI / OnchainOS integration ---
# CONFIRMED (2026-07-09): the real integration is the `onchainos` CLI, not a
# plain REST API. Source: github.com/okx/onchainos-skills.
# Setup (one-time, outside this app):
#   1. Get OKX_API_KEY / OKX_SECRET_KEY / OKX_PASSPHRASE from the OKX Developer Portal
#   2. Run `npx skills add okx/onchainos-skills` in this project
#   3. Install the `onchainos` CLI binary (web3.okx.com/onchainos/dev-docs)
#   4. Register a User-role agent identity: `onchainos agent create --role user`
#      -> gives you the OKX_AGENT_ID below
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
# User-role agent (the buyer identity this app posts tasks as)
OKX_AGENT_ID=
# ASP-role agent (the provider identity that receives and fulfils job invites)
OKX_ASP_AGENT_ID=
# ASP service offered on the designated-task path. The fee MUST match your live
# listing — verify with: onchainos agent service-list --agent-id <ASP id>
OKX_ASP_SERVICE_ID=
OKX_ASP_SERVICE_FEE_USDT=
# Path to the onchainos binary if not on PATH
ONCHAINOS_BIN=onchainos
# Path to the okx-a2a binary if not on PATH (npm global prefix is often not).
# Required in live mode: this daemon delivers inbound job invites. Without it
# the agent still reports "online" via heartbeat but silently receives nothing.
#   npm install -g @okxweb3/a2a-node@latest && okx-a2a doctor --fix
OKX_A2A_BIN=okx-a2a
# AI-provider failover order for the daemon (npm run watchdog). The daemon binds
# ONE provider to drive the apply/deliver playbook; if it dies (expired login,
# exhausted quota) invites are silently dropped. The watchdog fails over to the
# next working provider in this list. Keep a free/local one (hermes) last as the
# guaranteed floor.
OKX_PROVIDER_PRIORITY=claude,codex,hermes

# --- App ---
PORT=3000
# "mock" (default, safe to demo without live credentials) or "live"
MARKETPLACE_MODE=mock
