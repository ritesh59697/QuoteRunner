# Dependency directories
node_modules/

# Local environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs (npm, and app runtime logs like watchdog.log / srv.log)
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# System files
.DS_Store
Thumbs.db

# Screenshots and attachments the desktop client drops into the repo.
# These are pasted chat images — they can contain private conversations and
# credentials, and this is a public repo. Never commit them.
.hermes/

# Local agent working notes — kept out of the public repo by choice.
CLAUDE.md

# Raw log exports the daemon's AI session generates on request (e.g. "export
# a log for job X"). These carry the deliverable's raw decryption
# secret/salt/nonce in plaintext — never belongs in a public repo. Use
# docs/job-<id>-delivery-evidence.md for a redacted, shareable writeup instead.
job_*_export_logs.txt

# Raw demo screen recordings and their working captions. These regularly clear
# GitHub's 100MB per-file hard limit and don't belong in git history — the
# canonical copy of the demo video is the project's #OKXAI post on X.
public/lv_*.mp4
public/captions.srt
